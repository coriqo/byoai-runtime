{
  "venvPath": ".",
  "venv": ".venv",
  "exclude": [".venv", "**/__pycache__"],
  // Byte-for-byte copy of the Coriqo reference reader (pinned by SHA-256 in
  // tests/recorder/test_mandate_file.py); it must not be edited to satisfy the
  // type checker. Decimal.as_tuple().exponent is `int | Literal['n','N','F']`
  // and the reader compares it to an int after ruling out non-finite values.
  //
  // scripts/gen_extension_icons.py is a maintainer-run asset generator that needs
  // Pillow, which is not a dependency of any extra; it is not type-checked.
  "ignore": ["src/byoai/recorder/mandate_format.py", "scripts/gen_extension_icons.py"],
  "executionEnvironments": [
    {
      // Tests: relax only the rules that fire on test-double style code, not
      // the ones that catch real mistakes (undefined names, bad calls, wrong
      // return types stay on). Tests read optional results (`ledger.last()["x"]`)
      // where a None is itself a failing test, assign fake attributes onto
      // stand-in request/flow objects, and load modules by file path. Source
      // under src/ and the examples keep the full rule set.
      "root": "tests",
      "extraPaths": ["src", "."],
      "reportOptionalSubscript": "none",
      "reportOptionalMemberAccess": "none",
      "reportOptionalOperand": "none",
      "reportOptionalIterable": "none",
      "reportOptionalCall": "none",
      "reportAttributeAccessIssue": "none",
      "reportArgumentType": "none",
      "reportOperatorIssue": "none",
      "reportPossiblyUnboundVariable": "none",
      "reportFunctionMemberAccess": "none",
      "reportGeneralTypeIssues": "none",
      "reportCallIssue": "none"
    },
    { "root": "." }
  ]
}
