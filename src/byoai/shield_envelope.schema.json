{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coriqo.com/schemas/shield-event-envelope-v1.json",
  "title": "Shield event envelope v1",
  "description": "Additive envelope fields carried inside an existing Shield row (or, for recorder events, derived from the event and never written into its payload). Validates a row that carries the envelope; every pre-existing row field stays allowed, but message-text field names never are. See docs/shield-event-envelope.md.",
  "type": "object",
  "required": [
    "kind",
    "envelope_version",
    "ai_event_type",
    "evidence_level",
    "collector",
    "policy_action",
    "outcome"
  ],
  "properties": {
    "kind": {
      "anyOf": [
        {
          "enum": [
            "browser.chat.request",
            "browser.chat.reply",
            "browser.chat.status",
            "browser.chat.attachment",
            "browser.health.unmatched",
            "browser.health.core_missing",
            "desktop.chat.request",
            "desktop.chat.response",
            "desktop.chat.attachment",
            "desktop.verdict.denied",
            "desktop.meta",
            "desktop.health.unmatched",
            "tool.call",
            "tool.result",
            "tool.error",
            "tool_use",
            "tool_result",
            "mandate_verdict"
          ]
        },
        {
          "pattern": "^scanner\\.[a-z_]+$"
        }
      ],
      "description": "Existing row kind. For recorder events, the EventKind value (tool_use, tool_result, mandate_verdict); recorder payloads do not carry it."
    },
    "envelope_version": {
      "const": 1
    },
    "ai_event_type": {
      "enum": [
        "ai.model.requested",
        "ai.model.response",
        "ai.tool_call.requested",
        "ai.tool.result",
        "ai.tool.executed",
        "ai.data.attachment",
        "ai.policy.enforced",
        "ai.policy.evaluated",
        "ai.app.discovered",
        "ai.app.visited",
        "ai.collector.health",
        "ai.mcp.configured",
        "ai.runtime.detected"
      ]
    },
    "evidence_level": {
      "enum": [
        "observed",
        "observed_requested",
        "inferred",
        "verified",
        "unobservable_payload",
        "unattested"
      ]
    },
    "collector": {
      "enum": [
        "browser_extension",
        "desktop_proxy",
        "mcp_interposer",
        "recorder",
        "governed_tool",
        "scanner"
      ]
    },
    "policy_action": {
      "enum": [
        "none",
        "observe",
        "allow",
        "flag",
        "warn",
        "redact",
        "block",
        "pending_approval"
      ],
      "description": "What policy decided. Not what happened."
    },
    "outcome": {
      "enum": [
        "not_applicable",
        "unknown",
        "sent",
        "sent_redacted",
        "blocked",
        "cancelled",
        "answered",
        "failed",
        "uploaded",
        "removed",
        "allowed",
        "denied"
      ],
      "description": "What happened to the thing the row is about."
    },
    "app": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "detection": {
      "$ref": "#/$defs/detection"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/legacy_fields"
    },
    {
      "if": {
        "properties": {
          "kind": {
            "pattern": "^browser\\."
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "propertyNames": {
          "enum": [
            "kind",
            "envelope_version",
            "ai_event_type",
            "evidence_level",
            "collector",
            "policy_action",
            "outcome",
            "app",
            "model",
            "tool",
            "agent",
            "detection",
            "wall_clock",
            "chars",
            "wire",
            "sent_at",
            "row_id",
            "send_id",
            "gate_id",
            "stage",
            "reason",
            "flags",
            "redactions",
            "verdict",
            "tools",
            "sources",
            "mime",
            "bytes",
            "sha256",
            "name_hash",
            "scanned",
            "rules_version",
            "path",
            "ok",
            "status"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "pattern": "^desktop\\."
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "propertyNames": {
          "enum": [
            "kind",
            "envelope_version",
            "ai_event_type",
            "evidence_level",
            "collector",
            "policy_action",
            "outcome",
            "app",
            "model",
            "tool",
            "agent",
            "detection",
            "wall_clock",
            "target",
            "action",
            "not_covered",
            "text_hmac",
            "chars",
            "flags",
            "redactions",
            "verdict",
            "status",
            "path",
            "bytes",
            "sha256",
            "scanned",
            "mime",
            "rules_version",
            "preview",
            "name_hash"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "tool.call",
              "tool.result",
              "tool.error"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "propertyNames": {
          "enum": [
            "kind",
            "envelope_version",
            "ai_event_type",
            "evidence_level",
            "collector",
            "policy_action",
            "outcome",
            "app",
            "model",
            "tool",
            "agent",
            "detection",
            "wall_clock",
            "call_id",
            "chars",
            "payload_hash",
            "mandate_verdict",
            "error_type",
            "identity"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "tool_use",
              "tool_result",
              "mandate_verdict"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "propertyNames": {
          "enum": [
            "kind",
            "envelope_version",
            "ai_event_type",
            "evidence_level",
            "collector",
            "policy_action",
            "outcome",
            "app",
            "model",
            "tool",
            "agent",
            "detection",
            "wall_clock"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "pattern": "^scanner\\."
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "propertyNames": {
          "enum": [
            "kind",
            "envelope_version",
            "ai_event_type",
            "evidence_level",
            "collector",
            "policy_action",
            "outcome",
            "app",
            "model",
            "tool",
            "agent",
            "detection",
            "wall_clock"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "browser.chat.request"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.model.requested",
              "ai.app.visited"
            ]
          },
          "collector": {
            "enum": [
              "browser_extension"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "browser.chat.reply"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.model.response",
              "ai.tool_call.requested"
            ]
          },
          "collector": {
            "enum": [
              "browser_extension"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed",
              "observed_requested"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "browser.chat.status"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.model.response"
            ]
          },
          "collector": {
            "enum": [
              "browser_extension"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "browser.chat.attachment"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.data.attachment"
            ]
          },
          "collector": {
            "enum": [
              "browser_extension"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "browser.health.unmatched"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.collector.health"
            ]
          },
          "collector": {
            "enum": [
              "browser_extension"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "browser.health.core_missing"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.collector.health"
            ]
          },
          "collector": {
            "enum": [
              "browser_extension"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "desktop.chat.request"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.model.requested",
              "ai.app.visited"
            ]
          },
          "collector": {
            "enum": [
              "desktop_proxy"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "desktop.chat.response"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.model.response",
              "ai.tool_call.requested"
            ]
          },
          "collector": {
            "enum": [
              "desktop_proxy"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed",
              "observed_requested"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "desktop.chat.attachment"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.data.attachment"
            ]
          },
          "collector": {
            "enum": [
              "desktop_proxy"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "desktop.verdict.denied"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.policy.enforced"
            ]
          },
          "collector": {
            "enum": [
              "desktop_proxy"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "desktop.meta"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.app.discovered",
              "ai.app.visited"
            ]
          },
          "collector": {
            "enum": [
              "desktop_proxy"
            ]
          },
          "evidence_level": {
            "enum": [
              "unobservable_payload",
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "desktop.health.unmatched"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.collector.health"
            ]
          },
          "collector": {
            "enum": [
              "desktop_proxy"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool.call"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.tool_call.requested"
            ]
          },
          "collector": {
            "enum": [
              "mcp_interposer"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed_requested"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool.result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.tool.result"
            ]
          },
          "collector": {
            "enum": [
              "mcp_interposer"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool.error"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.tool.result"
            ]
          },
          "collector": {
            "enum": [
              "mcp_interposer"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool_use"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.tool_call.requested"
            ]
          },
          "collector": {
            "enum": [
              "recorder"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed_requested"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool_result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.tool.result",
              "ai.tool.executed"
            ]
          },
          "collector": {
            "enum": [
              "recorder",
              "governed_tool"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed",
              "verified"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mandate_verdict"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.policy.evaluated"
            ]
          },
          "collector": {
            "enum": [
              "recorder"
            ]
          },
          "evidence_level": {
            "enum": [
              "observed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ai_event_type": {
            "const": "ai.tool_call.requested"
          }
        },
        "required": [
          "ai_event_type"
        ]
      },
      "then": {
        "properties": {
          "evidence_level": {
            "const": "observed_requested"
          },
          "tool": {
            "properties": {
              "status": {
                "const": "requested"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "tool"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ai_event_type": {
            "const": "ai.tool.result"
          }
        },
        "required": [
          "ai_event_type"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "properties": {
              "status": {
                "const": "result"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "tool"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ai_event_type": {
            "const": "ai.tool.executed"
          }
        },
        "required": [
          "ai_event_type"
        ]
      },
      "then": {
        "properties": {
          "collector": {
            "const": "governed_tool"
          },
          "tool": {
            "properties": {
              "status": {
                "const": "executed"
              },
              "execution_source": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "execution_source"
            ]
          }
        },
        "required": [
          "tool"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ai_event_type": {
            "enum": [
              "ai.mcp.configured",
              "ai.runtime.detected"
            ]
          }
        },
        "required": [
          "ai_event_type"
        ]
      },
      "then": {
        "properties": {
          "collector": {
            "const": "scanner"
          },
          "evidence_level": {
            "const": "unattested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "pattern": "^scanner\\."
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "collector": {
            "const": "scanner"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "collector": {
            "const": "scanner"
          }
        },
        "required": [
          "collector"
        ]
      },
      "then": {
        "properties": {
          "evidence_level": {
            "const": "unattested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level": {
            "const": "unobservable_payload"
          }
        },
        "required": [
          "evidence_level"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "const": "ai.app.discovered"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ai_event_type": {
            "const": "ai.app.discovered"
          },
          "collector": {
            "const": "desktop_proxy"
          }
        },
        "required": [
          "ai_event_type",
          "collector"
        ]
      },
      "then": {
        "properties": {
          "evidence_level": {
            "const": "unobservable_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "properties": {
              "status": {
                "const": "executed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "const": "ai.tool.executed"
          },
          "collector": {
            "const": "governed_tool"
          }
        },
        "required": [
          "ai_event_type",
          "collector"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "properties": {
              "status": {
                "const": "requested"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "evidence_level": {
            "const": "observed_requested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level": {
            "const": "verified"
          }
        },
        "required": [
          "evidence_level"
        ]
      },
      "then": {
        "properties": {
          "collector": {
            "const": "governed_tool"
          },
          "ai_event_type": {
            "const": "ai.tool.executed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tools": {
            "minItems": 1
          }
        },
        "required": [
          "tools"
        ]
      },
      "then": {
        "properties": {
          "ai_event_type": {
            "const": "ai.tool_call.requested"
          },
          "evidence_level": {
            "const": "observed_requested"
          }
        },
        "required": [
          "ai_event_type",
          "evidence_level"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "collector": {
